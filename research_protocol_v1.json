  "research_direction": "Duplicate-Aware Source Aggregation for Selective Scientific Question Answering",
  "research_question": "Does aggregating distinct evidence by paper and section improve answer-or-abstain decisions over passage relevance thresholds, at matched answer coverage?",
  "benchmark_scale": {
    "total_question_families": 120,
    "total_contexts": 480,
    "split_allocation": {
      "train": {
        "families": 60,
        "contexts": 240,
        "single_passage_families": 30,
        "multi_passage_families": 30
      },
      "val": {
        "families": 24,
        "contexts": 96,
        "single_passage_families": 12,
        "multi_passage_families": 12
      },
      "test": {
        "families": 36,
        "contexts": 144,
        "single_passage_families": 18,
        "multi_passage_families": 18
      }
    },
    "conditions_per_family": [
      "supported_candidate",
      "relevant_replacement",
      "duplicate_replacement",
      "natural_retrieval"
    ]
  },
  "experimental_design": {
    "models": [
      "B0_AlwaysAccept",
      "B1_ValidationTunedThreshold",
      "B2_FrozenHistoricalGate",
      "B_Diag_Length",
      "M1_Relevance_Raw",
      "M2_Relevance_Dedup",
      "M3_Full_Raw",
      "M4_Full_Dedup"
    ],
    "regularization_grid_C": [0.01, 0.1, 1.0, 10.0, 100.0],
    "target_operating_coverages": [0.50, 0.75, 0.90],
    "bootstrap_resamples": 2000,
    "bootstrap_clustering": "connected_paper_components",
    "primary_comparisons": [
      {
        "name": "structural_benefit_post_dedup",
        "model_a": "M4_Full_Dedup",
        "model_b": "M2_Relevance_Dedup"
      },
      {
        "name": "dedup_benefit_with_structure",
        "model_a": "M4_Full_Dedup",
        "model_b": "M3_Full_Raw"
      },
      {
        "name": "dedup_benefit_relevance_only",
        "model_a": "M2_Relevance_Dedup",
        "model_b": "M1_Relevance_Raw"
      }
    ]
  },
