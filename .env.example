# AI Research Copilot - Environment Configuration Template
# Copy this file to .env and fill in your actual API keys before running real backend stages.

# ---------------------------------------------------------------------------
# 1. Hosted Generation Model Secret (REQUIRED for Phase 3 & 4)
# ---------------------------------------------------------------------------
# Google Gemini (gemini-3.5-flash-lite) API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# 2. RAGAS Evaluation Judge LLM Secrets (REQUIRED for Phase 5 per FR-20)
# ---------------------------------------------------------------------------
# Separate provider family judge LLM (GPT-4o-mini or Claude Haiku)
# OpenAI API Key for GPT-4o-mini judge:
OPENAI_API_KEY=your_openai_api_key_here

# OR Anthropic API Key for Claude Haiku judge:
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Note: If neither OPENAI_API_KEY nor ANTHROPIC_API_KEY is supplied,
# RAGAS explicitly falls back to Gemini as judge (documented limitation).

# ---------------------------------------------------------------------------
# 3. Engine Mode Toggle
# ---------------------------------------------------------------------------
# Set to 'false' to run real backend pipeline; 'true' to run mock engine
USE_MOCK_ENGINE=false
